rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.email is string && data.email.size() <= 120
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 350))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'videoFileName', 'videoDuration', 'language', 'targetLanguage', 'subtitles', 'style', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 150
        && (!('videoFileName' in data) || (data.videoFileName is string && data.videoFileName.size() <= 200))
        && (!('videoDuration' in data) || (data.videoDuration is number))
        && (!('language' in data) || (data.language is string && data.language.size() <= 50))
        && (!('targetLanguage' in data) || (data.targetLanguage is string && data.targetLanguage.size() <= 50))
        && (!('subtitles' in data) || (data.subtitles is list && data.subtitles.size() <= 600))
        && (!('style' in data) || (data.style is map))
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(request.resource.data);
      allow delete: if false;
    }

    // Subtitle Projects
    match /projects/{projectId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data);
      allow update: if isSignedIn() 
        && isValidId(projectId) 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == resource.data.userId
        && isValidProject(request.resource.data);
      allow delete: if isSignedIn() && isValidId(projectId) && resource.data.userId == request.auth.uid;
    }
  }
}
